ANTHROPIC_API_KEY=

# Set to true to add Chinese/Japanese/Korean font support to the agent
# sandbox image (adds ~200MB). See docs/build-and-runtime.md.
INSTALL_CJK_FONTS=false

# --- OneCLI Agent Vault ---
# The gateway that injects credentials (Anthropic/OpenAI/etc.) into agent
# containers at request time. Your OpenAI key is registered as a vault
# secret ("OpenAI"), not stored here directly.
ONECLI_URL=http://127.0.0.1:10254
ONECLI_API_KEY=

# --- OpenAI key (kept here per your request; LiteLLM's own config uses this to reach OpenAI) ---
OPENAI_API_KEY=

# --- Native `claude` provider, routed through the local LiteLLM proxy ---
# The stock claude provider speaks Anthropic's /v1/messages format. LiteLLM
# (running locally in WSL, port 4000) accepts that format and forwards the
# request to real OpenAI models using the key above, translating the
# response back to Anthropic's shape. ANTHROPIC_API_KEY above is only used
# as LiteLLM's auth token here, not sent to Anthropic.
ANTHROPIC_BASE_URL=
NANOCLAW_HARDENED_IMAGE=false
DEFAULT_AGENT_PROVIDER=
TZ=

# --- Telegram ---
# Default bot. Additional bot identities: TELEGRAM_INSTANCES=<name>[,<name>...]
# plus a per-instance TELEGRAM_BOT_TOKEN_<NAME> (name uppercased, dashes to
# underscores). See src/channels/telegram.ts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INSTANCES=
TELEGRAM_BOT_TOKEN_SERGEANT_STONE=
